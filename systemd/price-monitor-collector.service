[Unit]
Description=Price Monitor scheduled collector
Documentation=https://github.com/Sc4rlxrd/Dashboard-Java-e-Python

Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

ConditionPathExists=/opt/price-monitor/compose.yaml
ConditionPathExists=/opt/price-monitor/config/urls.txt
ConditionPathIsExecutable=/usr/local/sbin/run-price-collector.sh

[Service]
Type=oneshot

User=root
Group=root
UMask=0027

Environment=COMPOSE_ANSI=never
Environment=DOCKER_CLI_HINTS=false

ExecStart=/usr/local/sbin/run-price-collector.sh

TimeoutStartSec=3h
TimeoutStopSec=3min

KillSignal=SIGTERM
Restart=no

StandardOutput=journal
StandardError=journal
SyslogIdentifier=price-monitor-collector