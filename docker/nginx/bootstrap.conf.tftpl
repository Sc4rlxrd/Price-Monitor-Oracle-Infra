#
# Configuração temporária utilizada antes da emissão
# ou recuperação do certificado TLS.
#
# Apenas o desafio ACME fica acessível publicamente.
# O dashboard não é exposto por HTTP.
#

limit_conn_zone $binary_remote_addr
                zone=bootstrap_connections:1m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;
    server_tokens off;

    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 30s;

    reset_timedout_connection on;

    limit_conn bootstrap_connections 10;
    limit_conn_status 429;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy
               "camera=(), microphone=(), geolocation=()"
               always;

    #
    # Necessário para emissão e renovação pelo Certbot.
    #
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";

        try_files $uri =404;

        access_log off;
        log_not_found off;
    }

    #
    # Impede acesso a arquivos ocultos.
    # A exceção mantém o desafio ACME funcionando.
    #
    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    #
    # Antes do TLS, o dashboard permanece indisponível.
    #
    location / {
        default_type text/plain;
        add_header Retry-After "60" always;

        return 503 "Price Monitor temporariamente indisponivel durante a configuracao HTTPS.\n";
    }
}