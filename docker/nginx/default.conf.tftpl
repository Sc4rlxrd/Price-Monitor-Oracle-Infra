#
# Identifica somente requisições POST para o login.
#
map $request_method $wp_login_limit_key {
    default "";
    POST    $binary_remote_addr;
}

#
# Zonas pequenas para preservar memória.
#
limit_req_zone $wp_login_limit_key
               zone=wp_login:1m
               rate=5r/m;

limit_req_zone $binary_remote_addr
               zone=wp_comments:1m
               rate=2r/m;

limit_conn_zone $binary_remote_addr
                zone=wp_connections:1m;

#
# HTTP permanece disponível para o desafio ACME.
# Todo o restante é redirecionado para HTTPS.
#
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name __PUBLIC_IP__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";

        try_files $uri =404;

        access_log off;
        log_not_found off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

#
# Servidor HTTPS definitivo.
#
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    server_name __PUBLIC_IP__;
    server_tokens off;

    ssl_certificate
        /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 32m;

    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 60s;
    keepalive_timeout 30s;

    reset_timedout_connection on;

    limit_conn wp_connections 20;
    limit_conn_status 429;

    limit_req_status 429;
    limit_req_log_level warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    #
    # Não adicionar HSTS durante os primeiros testes.
    #

    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;

    #
    # O WordPress recebe HTTP dentro do Docker, mas deve saber
    # que o cliente original acessou por HTTPS.
    #
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Connection "";

    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    proxy_hide_header X-Powered-By;

    location = /xmlrpc.php {
        access_log off;
        return 403;
    }

    location = /wp-login.php {
        limit_req zone=wp_login burst=5 nodelay;

        proxy_pass http://wordpress:80;
    }

    location = /wp-comments-post.php {
        limit_req zone=wp_comments burst=3 nodelay;

        proxy_pass http://wordpress:80;
    }

    #
    # Estes endpoints permanecerão liberados até você concluir
    # a instalação inicial do novo WordPress.
    #
    # location = /wp-admin/install.php {
    #     return 403;
    # }
    #
    # location = /wp-admin/setup-config.php {
    #     return 403;
    # }

    location = /wp-config.php {
        return 404;
    }

    location = /readme.html {
        return 404;
    }

    location = /license.txt {
        return 404;
    }

    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    location ~* ^/wp-content/uploads/.*\.php(?:/|$) {
        return 403;
    }

    location ~* \.(?:bak|backup|old|orig|save|sql|swp|tmp)$ {
        return 404;
    }

    location ~* ^/(?:composer\.(?:json|lock)|package(?:-lock)?\.json|yarn\.lock)$ {
        return 404;
    }

    location / {
        proxy_pass http://wordpress:80;
    }
}