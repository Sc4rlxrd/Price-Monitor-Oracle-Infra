#
# Converte corretamente conexões HTTP em WebSocket
# quando o navegador solicitar protocol upgrade.
#
map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

#
# Rate limit e limite de conexões por endereço IP.
#
# O burst maior permite o carregamento inicial dos
# arquivos e conexões utilizados pelo Streamlit.
#
limit_req_zone $binary_remote_addr
               zone=dashboard_requests:1m
               rate=5r/s;

limit_conn_zone $binary_remote_addr
                zone=dashboard_connections:1m;

#
# HTTP:
# mantém o desafio ACME disponível e redireciona
# todas as demais requisições para HTTPS.
#
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name __PUBLIC_IP__;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";

        try_files $uri =404;

        access_log off;
        log_not_found off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

#
# Servidor HTTPS definitivo.
#
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;

    server_name __PUBLIC_IP__;
    server_tokens off;

    ssl_certificate
        /etc/letsencrypt/live/__PUBLIC_IP__/fullchain.pem;

    ssl_certificate_key
        /etc/letsencrypt/live/__PUBLIC_IP__/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;

    ssl_session_cache shared:SSL:2m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    ssl_prefer_server_ciphers off;

    client_max_body_size 32m;

    client_header_timeout 15s;
    client_body_timeout 60s;
    send_timeout 60s;
    keepalive_timeout 65s;

    reset_timedout_connection on;

    limit_conn dashboard_connections 20;
    limit_conn_status 429;

    limit_req_status 429;
    limit_req_log_level warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy
               "strict-origin-when-cross-origin"
               always;
    add_header Permissions-Policy
               "camera=(), microphone=(), geolocation=()"
               always;

    #
    # Ativar HSTS somente depois de validar:
    #
    # - acesso HTTPS;
    # - renovação do certificado;
    # - recuperação após reinicialização;
    # - reload automático do Nginx.
    #
    # add_header Strict-Transport-Security
    #            "max-age=31536000"
    #            always;

    #
    # Bloqueia arquivos ocultos.
    #
    location ~ /\.(?!well-known(?:/|$)) {
        return 404;
    }

    #
    # Bloqueia extensões comuns de backup e arquivos
    # que não devem ser publicados.
    #
    location ~* \.(?:bak|backup|old|orig|save|sql|swp|tmp)$ {
        return 404;
    }

    #
    # Proxy reverso para o Streamlit.
    #
    location / {
        #
        # Autenticação fornecida pelo Nginx.
        #
        auth_basic "Price Monitor";
        auth_basic_user_file /etc/nginx/auth/.htpasswd;

        #
        # Permite rajadas iniciais do navegador, mas limita
        # a taxa média de requisições de cada endereço IP.
        #
        limit_req zone=dashboard_requests burst=60 nodelay;

        proxy_pass http://dashboard:8501;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For
                         $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-Proto https;

        #
        # Necessário para o WebSocket do Streamlit.
        #
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_connect_timeout 10s;
        proxy_send_timeout 3600s;
        proxy_read_timeout 3600s;

        #
        # Mantém as respostas e conexões interativas do
        # Streamlit sem buffering no proxy.
        #
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache_bypass $http_upgrade;
        proxy_redirect off;

        proxy_hide_header X-Powered-By;
    }
}