#cloud-config

timezone: America/Sao_Paulo

package_update: false
package_upgrade: false

write_files:

  - path: /usr/local/sbin/bootstrap-wordpress.sh
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${bootstrap_script_b64}

  - path: /opt/wordpress/compose.yaml
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${compose_yaml_b64}

  - path: /opt/wordpress/nginx/bootstrap.conf
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${nginx_bootstrap_conf_b64}

  - path: /opt/wordpress/nginx/default.conf.tftpl
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${nginx_default_conf_b64}

  - path: /usr/local/sbin/configure-https.sh
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${configure_https_script_b64}

  - path: /usr/local/sbin/reload-wordpress-nginx.sh
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${reload_nginx_script_b64}

  - path: /usr/local/bin/vm-monitor-telegram
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${monitor_script_b64}

  - path: /etc/systemd/system/vm-monitor-telegram.service
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${monitor_service_b64}

  - path: /etc/systemd/system/vm-monitor-telegram.timer
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${monitor_timer_b64}

runcmd:
  - [timedatectl, set-ntp, "true"]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, vm-monitor-telegram.timer]
  - [bash, /usr/local/sbin/bootstrap-wordpress.sh]
  - [bash, /usr/local/sbin/configure-https.sh, "${letsencrypt_email}", "${letsencrypt_staging}"]

final_message: "WordPress, HTTPS/TLS, timezone, NTP e monitoramento provisionados."